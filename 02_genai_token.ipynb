     "output_type": "stream",
     "text": [
      "Decoded Tokens: Hi There! My name is Pramod\n"
     ]
    }
   ],
   "source": [
    "decoded = enc.decode(tokens)\n",
    "print(f\"Decoded Tokens: {decoded}\")"
   ]
