   "source": [
    "import tiktoken\n",
    "\n",
    "enc = tiktoken.encoding_for_model(\"gpt-4.1-mini\")\n",
    "text = \"Hi There! My name is Pramod\"\n",
    "tokens = enc.encode(text)\n",
    "\n",
    "print(f\"Tokens: {tokens}\")\n"
   ]
  },
  {
